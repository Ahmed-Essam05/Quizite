# Database
DATABASELINK=mongodb+srv://<username>:<password>@<cluster>/<database>
PORT=8000
# Optional local port for `npm run start:frontend`; defaults to 4173.
WEB_PORT=4173

# Authentication: use a long, random value in the real config.env file.
JWT_SECRET=replace-with-a-long-random-secret

# Password-reset email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=mailer@example.com
EMAIL_PASSWORD=replace-with-smtp-password
EMAIL_FROM=Quiz Website <no-reply@example.com>

# Optional frontend reset page; the raw reset token is appended as ?token=...
PASSWORD_RESET_URL=https://example.com/reset-password
