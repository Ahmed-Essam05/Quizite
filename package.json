{
  "name": "quizite",
  "version": "1.0.0",
  "description": "Quiz creation and taking platform built with Node.js, Express, and MongoDB",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=development nodemon server.js",
    "start:frontend": "NODE_ENV=development nodemon frontendServer.js",
    "start:prod": "NODE_ENV=production nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "debug": "ndb server.js",
    "watch:js": "parcel watch ./public/js/index.js --out-dir ./public/js --out-file bundle.js",
    "build:js": "parcel build ./public/js/index.js --out-dir ./public/js --out-file bundle.js"
  },
  "author": "Ahmed Essam",
  "license": "ISC",
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^5.13.23",
    "morgan": "^1.11.0",
    "multer": "^1.4.4",
    "nodemailer": "^9.0.6",
    "pug": "^3.0.4",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^14.1.0",
    "mongodb-memory-server": "^11.3.0",
    "parcel-bundler": "^1.12.5",
    "prettier": "^3.9.6",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
